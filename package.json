{
  "name": "semver-comparator",
  "version": "1.1.0",
  "description": "A tiny semver comparator.",
  "homepage": "https://github.com/gzzhanghao/semver-comparator#readme",
  "bugs": {
    "url": "https://github.com/gzzhanghao/semver-comparator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzzhanghao/semver-comparator.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest --coverage",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "changeset": "^0.2.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-lts": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260317.1",
    "@vitest/coverage-v8": "4.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.32.1"
}
